# =====================================================================================
# Catalog Maker: environment variables (PLACEHOLDERS ONLY. Never commit real values.)
# Local: copy to ".env". Vercel: add each one under Project > Settings > Environment Variables.
# =====================================================================================

# ---- Database (REQUIRED) -------------------------------------------------------------
# Runtime connection. On Neon/Supabase/Vercel Postgres use the POOLED string.
#   Neon pooled:      postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Supabase pooler:  postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/catalog_maker?sslmode=require"
# Direct (non-pooled) connection used only by Prisma schema commands (migrate deploy / db push).
# If your provider has no pooler, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/catalog_maker?sslmode=require"

# ---- Admin & scheduled sync (REQUIRED in production) ---------------------------------
# Protects /api/admin/* (and the Part 3 admin panel login). Use a long random value, e.g. `openssl rand -base64 32`.
ADMIN_PASSWORD="change-me-to-a-long-random-string"
# Protects /api/cron/sync. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="change-me-to-another-long-random-string"

# ---- Catalog / client -----------------------------------------------------------------
# Which Client row the site serves when the request host does not match a Client.domain (single-client mode).
DEFAULT_CLIENT_SLUG="demo"
# Used only by `npm run db:seed` for the demo client. The live number is managed in the admin panel (stored in the database).
# International format, digits only (e.g. 919876543210).
WHATSAPP_NUMBER="919999999999"

# ---- Shopify (optional here: credentials can also be saved per source via POST /api/admin/sources) ----
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"
# Admin API access token from a custom app with the read_products scope. Leave empty to use the public /products.json feed.
SHOPIFY_ACCESS_TOKEN="shpat_your_token_here"

# ---- WooCommerce (optional here: same as above) ----------------------------------------
WOOCOMMERCE_SITE_URL="https://your-wordpress-site.com"
WOOCOMMERCE_CONSUMER_KEY="ck_your_key_here"
WOOCOMMERCE_CONSUMER_SECRET="cs_your_secret_here"
